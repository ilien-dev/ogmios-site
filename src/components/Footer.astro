---
import Mark from "./Mark.astro";
import { LINKS, type Strings } from "../i18n/strings";
import { topics } from "../i18n/topics";
interface Props {
  t: Strings;
  /** The same page in the other language. */
  otherHref: string;
}
const { t, otherHref } = Astro.props;
const home = t.lang === "en" ? "/" : "/es/";
const link = "inline-block text-[15px] text-ink-soft no-underline transition-[color,translate] duration-300 ease-out-expo hover:translate-x-1 hover:text-ink";
---

<footer class="relative overflow-hidden">
  <div class="mx-auto max-w-[1240px] px-4 sm:px-8">
    <div class="grid gap-10 border-t border-line py-12 sm:grid-cols-2 nav:grid-cols-[2fr_1fr_1fr_1fr]">
      <div data-rv>
        <div class="flex items-center gap-2.5"><Mark size={26} /><span class="text-[18px] font-bold">Ogmios</span></div>
        <p class="mt-3 max-w-[320px] text-[15px] text-ink-soft">{t.footer.tagline}</p>
      </div>
      <nav data-rv style="--d:.08s" aria-label={t.footer.product} class="flex flex-col items-start gap-2.5">
        <span class="text-[14px] font-semibold">{t.footer.product}</span>
        <a class={link} href={`${home}#conversation`}>{t.nav.talk}</a>
        <a class={link} href={`${home}#books`}>{t.nav.books}</a>
        <a class={link} href={`${home}#review`}>{t.nav.review}</a>
        <a class={link} href={`${home}#memory`}>{t.nav.memory}</a>
        <a class={link} href={topics[t.lang].claude.paths[t.lang]}>{topics[t.lang].claude.eye}</a>
        <a class={link} href={topics[t.lang].books.paths[t.lang]}>{topics[t.lang].books.eye}</a>
      </nav>
      <nav data-rv style="--d:.16s" aria-label={t.footer.project} class="flex flex-col items-start gap-2.5">
        <span class="text-[14px] font-semibold">{t.footer.project}</span>
        <a class={link} href={LINKS.repo}>{t.footer.source}</a>
        <a class={link} href={LINKS.releasesAll}>{t.footer.releases}</a>
        <a class={link} href={LINKS.license}>{t.footer.license}</a>
        <a class={link} href={LINKS.issues}>{t.footer.issues}</a>
      </nav>
      <nav data-rv style="--d:.24s" aria-label={t.footer.help} class="flex flex-col items-start gap-2.5">
        <span class="text-[14px] font-semibold">{t.footer.help}</span>
        <a class={link} href={`${home}#install`}>{t.footer.install}</a>
        <a class={link} href={`${home}#claude`}>{t.nav.claude}</a>
        <a class={link} href={`${home}#faq`}>{t.nav.faq}</a>
        <a class={link} href={otherHref} hreflang={t.lang === "en" ? "es" : "en"} lang={t.lang === "en" ? "es" : "en"}>{t.langSwitch.otherLong}</a>
      </nav>
    </div>
    <p data-rv class="max-w-[90ch] pb-6 text-[13px] text-ink-faint">{t.footer.legal}</p>
    <p data-rv aria-hidden="true" class="-mb-[0.2em] text-center text-[clamp(5.5rem,22vw,20rem)] leading-[0.9] font-extrabold tracking-[-0.06em] whitespace-nowrap text-line select-none">Ogmios</p>
  </div>
</footer>
