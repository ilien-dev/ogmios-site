---
import Mark from "./Mark.astro";
import type { Strings } from "../i18n/strings";
interface Props {
  t: Strings;
}
const { t } = Astro.props;
const home = t.lang === "en" ? "/" : "/es/";
const other = t.lang === "en" ? "es" : "en";
---

<header class="sticky top-0 z-30 animate-drop border-b border-line bg-(--nav) backdrop-blur-lg">
  <div class="mx-auto flex h-16 max-w-[1240px] items-center gap-3 px-4 sm:gap-5 sm:px-8">
    <a href={home} class="flex items-center gap-2.5 text-ink no-underline">
      <Mark size={30} />
      <span class="text-[19px] font-bold tracking-[-0.02em]">Ogmios</span>
    </a>
    <nav aria-label={t.nav.label} class="mx-auto hidden items-center gap-7 nav:flex">
      <a class="nav-link" href="#conversation">{t.nav.talk}</a>
      <a class="nav-link" href="#books">{t.nav.books}</a>
      <a class="nav-link" href="#review">{t.nav.review}</a>
      <a class="nav-link" href="#claude">{t.nav.claude}</a>
      <a class="nav-link" href="#faq">{t.nav.faq}</a>
    </nav>
    <a
      class="ml-auto inline-flex min-h-11 items-center gap-1.5 rounded-lg px-2.5 text-[14px] font-semibold text-ink-soft no-underline transition-colors duration-300 hover:bg-raised hover:text-ink nav:ml-0"
      href={t.langSwitch.otherHref}
      hreflang={other}
      lang={other}
      title={t.langSwitch.label}
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3c2.5 2.6 4 5.8 4 9s-1.5 6.4-4 9c-2.5-2.6-4-5.8-4-9s1.5-6.4 4-9z"></path>
      </svg>
      {t.langSwitch.other}
      <span class="sr-only">· {t.langSwitch.otherLong}</span>
    </a>
    <button
      type="button"
      data-theme-toggle
      aria-label={t.theme.label}
      aria-pressed="false"
      class="group grid size-11 place-items-center rounded-lg text-ink-soft transition-colors duration-300 hover:bg-raised hover:text-ink"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-500 ease-out-expo group-hover:rotate-45 group-aria-pressed:hidden">
        <circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="hidden transition-transform duration-500 ease-out-expo group-hover:-rotate-12 group-aria-pressed:block">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
      </svg>
    </button>
    <a class="btn btn-cta min-h-11! px-4! text-[14px]!" href="#install">{t.download}</a>
  </div>
  <div class="scroll-bar absolute inset-x-0 -bottom-px h-0.5 origin-left scale-x-0" aria-hidden="true"></div>
</header>
