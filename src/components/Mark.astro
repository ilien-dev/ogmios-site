---
// The mark of the app (its `assets/icon.svg`): the partner's orb with two voices closing
// an O inside it. Its colours are the same in both themes. It sits beside the name, so
// screen readers skip it.
interface Props {
  size?: number;
  class?: string;
}
const { size = 30, class: className } = Astro.props;
---

<svg width={size} height={size} viewBox="2 2 60 60" fill="none" stroke-width="8" stroke-linecap="round" aria-hidden="true" class:list={["orb shrink-0", className]}>
  <path d="M19.5 37A13.5 13.5 0 0 1 37 19.5" stroke="#23233a"></path>
  <path d="M44.5 27A13.5 13.5 0 0 1 27 44.5" stroke="#5b4bc4"></path>
</svg>
