---
// A page that answers one search (src/i18n/topics.ts): what it is, the app playing it,
// the steps, the reasons, real captures, its questions and the way to the download.
import Base from "../layouts/Base.astro";
import Stage from "./Stage.astro";
import type { Strings } from "../i18n/strings";
import type { Topic } from "../i18n/topics";
interface Props {
  t: Strings;
  topic: Topic;
  other: Topic;
}
const { t, topic, other } = Astro.props;
const home = t.lang === "en" ? "/" : "/es/";
const url = new URL(topic.paths[t.lang], Astro.site).href;
const wrap = "relative mx-auto max-w-[1100px] px-4 sm:px-8";
const h2 = "text-[1.9rem] leading-[1.1] font-bold tracking-[-0.03em] sm:text-[2.5rem]";
const book = topic.scene === "book";
// The steps of the page as a how-to, and where the page sits in the site.
const howLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: topic.howTitle,
  description: topic.howLead,
  inLanguage: t.htmlLang,
  tool: [{ "@type": "HowToTool", name: "Ogmios" }],
  step: topic.steps.map((step, i) => ({ "@type": "HowToStep", position: i + 1, name: step.title, text: step.body, url: `${url}#step-${i + 1}` })),
};
const crumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Ogmios", item: new URL(home, Astro.site).href },
    { "@type": "ListItem", position: 2, name: topic.h1, item: url },
  ],
};
---

<Base t={t} page={{ title: topic.title, description: topic.description, en: topic.paths.en, es: topic.paths.es, faq: topic.faq, ld: [howLd, crumbLd] }}>
  <section class="relative overflow-x-clip">
    <div class:list={["halo top-[300px] left-1/2 -ml-[340px] size-[680px]", book ? "bg-(--glow-c)" : "bg-(--glow-a)"]} aria-hidden="true"></div>
    <div class:list={[wrap, "flex flex-col items-center gap-6 pt-14 pb-14 text-center sm:pt-20"]}>
      <nav aria-label="Breadcrumb" class="animate-rise text-[14px] text-ink-soft">
        <a class="text-ink-soft no-underline transition-colors duration-300 hover:text-ink" href={home}>Ogmios</a>
        <span aria-hidden="true" class="mx-1.5">/</span>
        <span class:list={["font-semibold", book ? "text-book" : "text-partner"]}>{topic.eye}</span>
      </nav>
      <h1 class="max-w-[900px] animate-rise text-[2.4rem] leading-[1.05] font-bold tracking-[-0.035em] [animation-delay:60ms] sm:text-[4rem]">{topic.h1}</h1>
      <p class="max-w-[700px] animate-rise text-[19px] text-ink-soft [animation-delay:120ms]">{topic.lead}</p>
      <div class="flex animate-rise flex-wrap justify-center gap-3 [animation-delay:180ms]">
        <a class="btn btn-cta" href={`${home}#install`}>{topic.ctaAction} <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-plain" href="#how">{topic.howTitle}</a>
      </div>
      <div data-rv="z" class="mt-8 w-full max-w-[1000px]" style="--d:.15s">
        <Stage t={t} scene={topic.scene} label={topic.stageLabel} caption={topic.stageCaption} book={book} />
      </div>
    </div>
  </section>

  <section id="how" class="far py-16 sm:py-20">
    <div class={wrap}>
      <div class="mb-12 flex flex-col items-center gap-4 text-center">
        <h2 data-rv class={h2}>{topic.howTitle}</h2>
        <p data-rv class="max-w-[620px] text-[18px] text-ink-soft" style="--d:.08s">{topic.howLead}</p>
      </div>
      <ol class="m-0 grid list-none gap-5 p-0 sm:grid-cols-2 nav:grid-cols-3">
        {
          topic.steps.map((step, i) => (
            <li id={`step-${i + 1}`} data-rv class="card card-lift group p-7" style={`--d:${(i % 3) * 0.08}s`}>
              <span class:list={["grid size-11 place-items-center rounded-full text-[16px] font-bold transition-transform duration-500 ease-out-expo group-hover:scale-110", book ? "bg-book-soft text-book" : "bg-partner-soft text-partner"]}>{i + 1}</span>
              <h3 class="mt-5 text-[20px] font-bold tracking-[-0.02em]">{step.title}</h3>
              <p class="mt-1.5 text-[16px] text-ink-soft">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="far py-16 sm:py-20">
    <div class:list={[wrap, "flex flex-col gap-16"]}>
      {
        topic.sections.map((section, i) => {
          const shot = topic.shots[i];
          return (
            <div class:list={["grid items-center gap-10", shot && "nav:grid-cols-2"]}>
              <div data-rv={i % 2 ? "r" : "l"} class:list={["flex flex-col gap-4", i % 2 && shot && "nav:order-2"]}>
                <h2 class={h2}>{section.title}</h2>
                {section.body.map((text) => <p class="text-[18px] text-ink-soft">{text}</p>)}
              </div>
              {shot && (
                <figure data-rv={i % 2 ? "l" : "r"} class="m-0 overflow-hidden rounded-2xl bg-surface shadow-window">
                  <img src={`/screens/${shot.src}.png`} alt={shot.alt} width="1280" height="800" loading="lazy" decoding="async" class="block h-auto w-full" />
                </figure>
              )}
            </div>
          );
        })
      }
    </div>
  </section>

  <section id="faq" class="far py-16 sm:py-20">
    <div class="mx-auto max-w-[900px] px-4 sm:px-8">
      <h2 data-rv class:list={[h2, "mb-10 text-center"]}>{topic.faqTitle}</h2>
      <div class="flex flex-col gap-3">
        {
          topic.faq.map((item, i) => (
            <details data-rv class="faq card group" open={i === 0} style={`--d:${i * 0.05}s`}>
              <summary class="flex list-none items-center justify-between gap-5 px-6 py-5 text-[18px] font-semibold tracking-[-0.01em] [&::-webkit-details-marker]:hidden">
                {item.q}
                <span class="grid size-9 shrink-0 place-items-center rounded-full bg-ink text-canvas transition-[rotate,scale] duration-500 ease-out-expo group-open:rotate-180 group-hover:scale-110" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 9l6 6 6-6" /></svg>
                </span>
              </summary>
              <p class="max-w-[760px] px-6 pb-6 text-ink-soft">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="far py-16 sm:py-20">
    <div class={wrap}>
      <div data-rv="z" class="card flex flex-col items-center gap-6 overflow-hidden bg-dots px-6 py-16 text-center sm:px-10 sm:py-20">
        <span class:list={["relative size-[96px] animate-breathe shadow-glow", book ? "orb-book" : "orb"]} aria-hidden="true"></span>
        <h2 class="relative max-w-[760px] text-[2.1rem] leading-[1.05] font-bold tracking-[-0.035em] sm:text-[3.2rem]">{topic.ctaTitle}</h2>
        <p class="relative max-w-[600px] text-[18px] text-ink-soft">{topic.ctaLead}</p>
        <div class="relative flex flex-wrap justify-center gap-3">
          <a class="btn btn-cta" href={`${home}#install`}>{topic.ctaAction} <span class="arrow arrow-down" aria-hidden="true">↓</span></a>
          <a class="btn btn-plain" href={home}>{topic.back}</a>
        </div>
      </div>
      <a data-rv href={other.paths[t.lang]} class="card card-lift group mt-5 flex flex-wrap items-center justify-between gap-4 p-7 text-ink no-underline">
        <span class="flex flex-col gap-1">
          <span class="text-[14px] font-semibold text-ink-soft">{topic.other.label}</span>
          <span class="text-[22px] font-bold tracking-[-0.02em]">{topic.other.text}</span>
        </span>
        <span class="grid size-11 place-items-center rounded-full bg-ink text-canvas transition-transform duration-500 ease-out-expo group-hover:translate-x-1.5" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>
