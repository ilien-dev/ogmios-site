{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ogmios",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "ogmios.ilien.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Workers Builds runs `wrangler preview` on every branch other than main, and that
  // command refuses to run without this block.
  "previews": {}
}
